{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Remove Duplicate Files",
  "version": "0.1.0",
  "identifier": "de.gaszmann.remove-duplicate-files",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Remove Duplicate Files",
        "width": 1180,
        "height": 820,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}

